AWS_SECRET_ACCESS_KEY=test
USE_SECRETS_MANAGER=false
INVENTORY_SECRET_ID=foodbank/mohamed/inventory
INVENTORY_EXPORTS_BUCKET=foodbank-inventory-exports
CW_LOG_GROUP=/foodbank/inventory
